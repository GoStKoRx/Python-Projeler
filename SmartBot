chatbot = Chat(pairs, reflections)


def chatbot_cevapla():
    while True:
        user_input = input("Sen: ").lower()

        if "hakkında bilgi ver" in user_input:
            try:
                topic = user_input.replace("hakkında bilgi ver", "").strip()
                wiki_wiki = wikipediaapi.Wikipedia('tr')
                page = wiki_wiki.page(topic)
                if page.exists():
                    response = page.summary[:300] + "..."
                else:
                    response = "Üzgünüm, bu konuda bilgi bulamadım."
            except Exception as e:
                response = "Bir hata oluştu: " + str(e)

        elif "hava nasıl" in user_input:
            city = "İstanbul"
            api_key = "SENİN_HAVA_DURUMU_API_KEYİN"
            url = f"http://api.weatherapi.com/v1/current.json?key={api_key}&q={city}&lang=tr"
            response = requests.get(url).json()
            if "current" in response:
                temp = response["current"]["temp_c"]
                condition = response["current"]["condition"]["text"]
                response = f"{city} için hava durumu: {condition}, sıcaklık: {temp}°C"
            else:
                response = "Hava durumu bilgisi alınamadı."

        elif "hesapla" in user_input:
            try:
                expression = re.search(r"hesapla (.*)", user_input).group(1)
                result = eval(expression)
                response = f"Sonuç: {result}"
            except:
                response = "Geçerli bir işlem gir."

        else:
            response = chatbot.respond(user_input)

        print(f"Chatbot: {response}")

if __name__ == "__main__":
    chatbot_cevapla()
